#!/usr/bin/expect

set timeout 30
set server "one-climate@192.168.20.10"
set password "U8@1v3z#14"

puts "🔧 DEPLOYING OAUTH RESPONSE FORMAT FIX"
puts "======================================"

# SSH to server
spawn ssh -t $server
expect {
    "password:" {
        send "$password\r"
        exp_continue
    }
    "$ " {
        puts "✅ Connected to server"
    }
}

# Go to project directory
send "cd team-workload\r"
expect "$ "

# Kill old backend
puts "🔪 Stopping backend service..."
send "pkill -f single_login_backend\r"
expect "$ "
send "sleep 3\r"
expect "$ "

# Start new backend
puts "🚀 Starting updated backend..."
send "nohup node single_login_backend.js > backend_oauth_fix.log 2>&1 &\r"
expect "$ "

# Wait for startup
puts "⏳ Waiting for service to start..."
send "sleep 8\r"
expect "$ "

# Test system status
puts "🧪 Testing system status..."
send "curl -s http://localhost:7812/api/v2/system/status\r"
expect {
    "is_operational" {
        puts "✅ Backend operational!"
    }
    "$ " {}
}

# Test OAuth user response format
puts "🔐 Testing OAuth user response format..."
send "curl -X POST -H 'Content-Type: application/json' -d '{\"email\":\"yterayut@gmail.com\",\"password\":\"test\"}' http://localhost:7812/api/v2/auth/login\r"
expect {
    "oauth_setup_required" {
        puts "✅ OAuth response format fixed!"
    }
    "$ " {}
}

# Test regular user still works
puts "👤 Testing regular user..."
send "curl -X POST -H 'Content-Type: application/json' -d '{\"email\":\"chaiwutwck@gmail.com\",\"password\":\"12345\"}' http://localhost:7812/api/v2/auth/login\r"
expect {
    "Login successful" {
        puts "✅ Regular user login working!"
    }
    "$ " {}
}

puts ""
puts "🎉 OAUTH RESPONSE FIX DEPLOYED!"
puts "================================"
puts "✅ Backend: http://192.168.20.10:7812"
puts "✅ Frontend: http://192.168.20.10:8888"
puts "🔐 Test: http://192.168.20.10:8888/login"
puts ""
puts "🧪 TEST WITH yterayut@gmail.com"
puts "   Expected: OAuth setup required message with redirect"

send "exit\r"
expect eof