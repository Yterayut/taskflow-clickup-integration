{
  "name": "taskflow-pro-single-login",
  "version": "3.0.0",
  "description": "TaskFlow Pro Phase 3 Real-Time System with WebSocket Support",
  "main": "single_login_backend.js",
  "scripts": {
    "start": "NODE_ENV=production node backend_postgresql_enhanced.js",
    "dev": "NODE_ENV=development nodemon backend_postgresql_enhanced.js",
    "start:sqlite": "USE_POSTGRESQL=false node backend_postgresql_enhanced.js",
    "start:postgresql": "USE_POSTGRESQL=true node backend_postgresql_enhanced.js",
    "migrate:postgresql": "node -e \"const {PostgreSQLService} = require('./services/PostgreSQLService'); const db = new PostgreSQLService(); db.connect().then(() => db.migrate().then(() => process.exit(0)));\"",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:unit": "jest --testMatch='**/tests/unit/**/*.test.js'",
    "test:integration": "jest --testMatch='**/tests/integration/**/*.test.js'",
    "migrate": "node database/run_migration.js",
    "seed": "node database/seed_data.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "validate": "npm run lint && npm run test",
    "build": "echo 'Build completed - ready for deployment'",
    "health-check": "curl -f http://localhost:7812/health || exit 1"
  },
  "dependencies": {
    "axios": "^1.4.0",
    "bcrypt": "^5.1.0",
    "better-sqlite3": "^11.10.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.1.4",
    "express": "^4.18.2",
    "express-rate-limit": "^6.7.0",
    "express-session": "^1.17.3",
    "ioredis": "^5.7.0",
    "jsonwebtoken": "^9.0.0",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.5",
    "pg": "^8.11.0",
    "socket.io": "^4.7.2",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "eslint": "^8.43.0",
    "jest": "^29.5.0",
    "nodemon": "^2.0.22",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "keywords": [
    "authentication",
    "single-login",
    "domain-driven-design",
    "clickup-oauth",
    "jwt",
    "nodejs",
    "postgresql"
  ],
  "author": "TaskFlow Pro Team",
  "license": "MIT",
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "domain/**/*.js",
      "application/**/*.js",
      "infrastructure/**/*.js",
      "api/**/*.js",
      "!**/node_modules/**"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ]
  }
}
