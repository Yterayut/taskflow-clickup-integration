[Unit]
Description=TaskFlow ClickUp Callback Service
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/home/one-climate/team-workload
ExecStart=/usr/bin/node clickup_callback_service.js
Restart=always
RestartSec=10
Environment=NODE_ENV=production
Environment=PORT=777

# Logging
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=taskflow-callback

# Security
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/home/one-climate/team-workload

[Install]
WantedBy=multi-user.target