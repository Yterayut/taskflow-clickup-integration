# TaskFlow Pro Authentication Environment Configuration

# Database Configuration
DB_USER=postgres
DB_HOST=localhost
DB_NAME=taskflow_auth
DB_PASSWORD=your_secure_password
DB_PORT=5432

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ClickUp OAuth Configuration
CLICKUP_CLIENT_ID=your_clickup_client_id
CLICKUP_CLIENT_SECRET=your_clickup_client_secret
CLICKUP_REDIRECT_URI=http://localhost:7810/auth/clickup/callback

# Server Configuration
PORT=7810
NODE_ENV=development

# Security Configuration
BCRYPT_SALT_ROUNDS=12
COOKIE_SECRET=your_cookie_secret_key

# CORS Configuration
CORS_ORIGIN=http://localhost:8888,http://192.168.20.10:8888

# Session Configuration
SESSION_SECRET=your_session_secret_key
SESSION_MAX_AGE=604800000

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log
EOF < /dev/null