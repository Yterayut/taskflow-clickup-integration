# Test Environment Configuration
NODE_ENV=test
AUTH_PORT=7811

# Test Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=taskflow_pro_test
DB_USER=taskflow_user
DB_PASSWORD=TaskFlow2025Secure
DB_SSL=false

# JWT Configuration for Testing
JWT_SECRET=test_jwt_secret_key_for_testing_only_not_for_production_use
JWT_EXPIRES_IN=1h
JWT_ISSUER=taskflow-pro-test
JWT_AUDIENCE=taskflow-users-test

# Bcrypt Configuration (lower rounds for faster tests)
BCRYPT_SALT_ROUNDS=4

# ClickUp OAuth Configuration (test values)
CLICKUP_CLIENT_ID=test_client_id
CLICKUP_CLIENT_SECRET=test_client_secret
CLICKUP_REDIRECT_URI=http://localhost:7811/auth/callback

# Frontend URLs (test)
FRONTEND_URL=http://localhost:8889
DASHBOARD_URL=http://localhost:8889

# Security Configuration (test)
COOKIE_SECRET=test_cookie_secret
SESSION_SECRET=test_session_secret

# Rate Limiting (relaxed for testing)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=error
LOG_FILE=test_auth_service.log

# CORS Origins (test)
CORS_ORIGINS=http://localhost:8889,http://127.0.0.1:8889