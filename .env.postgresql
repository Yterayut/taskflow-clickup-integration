# TaskFlow Pro PostgreSQL Configuration
# Copy this file to .env or set these variables in your environment

# Database Configuration
USE_POSTGRESQL=true
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=taskflow_pro
PG_USER=postgres
