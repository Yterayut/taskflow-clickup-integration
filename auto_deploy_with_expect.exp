#!/usr/bin/expect

set timeout 30
set server "one-climate@192.168.20.10"
set password "U8@1v3z#14"

puts "🚀 Automated Deploy with Expect - Login Loop Fix"
puts "================================================="

# SSH to server
spawn ssh -t $server
expect {
    "password:" {
        send "$password\r"
        exp_continue
    }
    "$ " {
        puts "✅ Connected to server"
    }
    timeout {
        puts "❌ SSH connection timeout"
        exit 1
    }
}

# Update nginx config
puts "🔧 Updating nginx configuration..."
send "sudo cp /tmp/taskflow_8888_new.nginx.conf /etc/nginx/sites-available/taskflow_8888\r"
expect {
    "password" {
        send "$password\r"
        exp_continue
    }
    "$ " {
        puts "✅ Nginx config updated"
    }
}

# Test nginx config
puts "🧪 Testing nginx configuration..."
send "sudo nginx -t\r"
expect {
    "password" {
        send "$password\r"
        exp_continue
    }
    "syntax is ok" {
        puts "✅ Nginx config is valid"
    }
    "$ " {}
}

# Reload nginx
puts "🔄 Reloading nginx..."
send "sudo systemctl reload nginx\r"
expect {
    "password" {
        send "$password\r"
        exp_continue
    }
    "$ " {
        puts "✅ Nginx reloaded"
    }
}

# Go to project directory
send "cd /home/one-climate/team-workload\r"
expect "$ "

# Install npm dependencies
puts "📦 Installing npm dependencies..."
send "npm install --only=production\r"
expect "$ " {
    puts "✅ NPM dependencies installed"
}

# Kill existing backend
puts "🔪 Stopping existing backend..."
send "pkill -f 'single_login_backend.js'\r"
expect "$ "
send "sleep 2\r"
expect "$ "

# Start backend
puts "🚀 Starting backend service..."
send "nohup node single_login_backend.js > backend_production.log 2>&1 &\r"
expect "$ "

# Wait and test backend
puts "⏳ Testing backend startup..."
send "sleep 5\r"
expect "$ "
send "curl -s http://localhost:7812/api/v2/system/status\r"
expect {
    "is_operational" {
        puts "✅ Backend is operational!"
    }
    "$ " {}
}

# Final status
puts ""
puts "🎉 Deployment completed!"
puts "✅ Backend: http://192.168.20.10:7812"
puts "✅ Frontend: http://192.168.20.10:8888"
puts "🔐 Login: http://192.168.20.10:8888/login"

send "exit\r"
expect eof