{
  "name": "taskflow-pro-auth-tests",
  "version": "1.0.0",
  "description": "Comprehensive test suite for TaskFlow Pro Authentication System",
  "scripts": {
    "test": "jest --verbose --detectOpenHandles",
    "test:unit": "jest --testPathPattern=unit --verbose",
    "test:integration": "jest --testPathPattern=integration --verbose",
    "test:watch": "jest --watch --verbose",
    "test:coverage": "jest --coverage --verbose",
    "test:setup": "node tests/test-setup.js",
    "test:teardown": "node tests/test-teardown.js",
    "test:db": "jest --testPathPattern=database --verbose"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFilesAfterEnv": ["<rootDir>/tests/jest.setup.js"],
    "collectCoverageFrom": [
      "auth/**/*.js",
      "database/**/*.js",
      "*.js",
      "!tests/**",
      "!coverage/**",
      "!node_modules/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    },
    "testTimeout": 30000,
    "verbose": true
  },
  "dependencies": {
    "express": "^4.18.2",
    "pg": "^8.11.3",
    "bcrypt": "^5.1.1",
    "jsonwebtoken": "^9.0.2",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5",
    "dotenv": "^16.3.1",
    "axios": "^1.6.2",
    "express-validator": "^7.0.1",
    "morgan": "^1.10.0",
    "compression": "^1.7.4"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "@types/jest": "^29.5.8",
    "@types/supertest": "^2.0.16",
    "jest-environment-node": "^29.7.0"
  }
}