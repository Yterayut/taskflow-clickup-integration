[Unit]
Description=TaskFlow Pro Single Login Authentication Service
After=network.target

[Service]
Type=simple
User=one-climate
WorkingDirectory=/home/one-climate/team-workload
ExecStart=/usr/bin/node single_login_backend.js
Restart=always
RestartSec=10
Environment=NODE_ENV=production
Environment=JWT_SECRET=taskflow_pro_jwt_secret_2025_secure_key_v2.1
Environment=DB_HOST=localhost
Environment=DB_USER=taskflow_user
Environment=DB_NAME=taskflow_pro
Environment=DB_PASSWORD=TaskFlow2025Secure
Environment=CLICKUP_CLIENT_ID=F9M7XRHB7T6Q78ZVL5077IT2HM89KTK5
Environment=CLICKUP_CLIENT_SECRET=TQ1U9MFFTFFMGLGJ8MEVN5MKTGQR7Y33XVQDZ4KSQJ1K
Environment=CLICKUP_REDIRECT_URI=http://192.168.20.10:7812/auth/clickup/callback
Environment=MASTER_USER_EMAIL=yterayut@gmail.com

# Logging
StandardOutput=append:/home/one-climate/team-workload/auth_backend.log
StandardError=append:/home/one-climate/team-workload/auth_backend.log

[Install]
WantedBy=multi-user.target