# Environment
NODE_ENV=development

# Server Configuration
HOST=localhost
PORT=5000

# Database Configuration
DATABASE_PATH=./data/taskflow.db
MIGRATIONS_PATH=./src/database/migrations
BACKUP_PATH=./data/backups

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d
JWT_ALGORITHM=HS256

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:8888

# Redis Configuration (optional)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=taskflow:

# ClickUp Integration
CLICKUP_CLIENT_ID=your-clickup-client-id
CLICKUP_CLIENT_SECRET=your-clickup-client-secret
CLICKUP_REDIRECT_URI=http://localhost:5000/api/auth/clickup/callback
CLICKUP_BASE_URL=https://api.clickup.com/api/v2
CLICKUP_AUTH_URL=https://app.clickup.com/api

# Email Configuration
EMAIL_PROVIDER=smtp
EMAIL_FROM=noreply@taskflowpro.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# File Upload Configuration
UPLOAD_MAX_FILE_SIZE=10485760
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/gif,application/pdf,text/plain
UPLOAD_PATH=./data/uploads

# Logging Configuration
LOG_LEVEL=info
LOG_FILE_ENABLED=true
LOG_FILE_PATH=./logs
LOG_FILE_MAX_SIZE=10
LOG_FILE_MAX_FILES=14d
LOG_CONSOLE_ENABLED=true
LOG_CONSOLE_COLORIZE=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
RATE_LIMIT_AUTH_MAX=5