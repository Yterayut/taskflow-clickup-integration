{
  "name": "taskflow-pro-single-login",
  "version": "2.1.0",
  "description": "TaskFlow Pro Single Login Authentication System with Domain-Driven Design",
  "main": "single_login_backend.js",
  "scripts": {
    "start": "NODE_ENV=production node single_login_backend.js",
    "dev": "NODE_ENV=development nodemon single_login_backend.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:unit": "jest --testMatch='**/tests/unit/**/*.test.js'",
    "test:integration": "jest --testMatch='**/tests/integration/**/*.test.js'",
    "migrate": "node database/run_migration.js",
    "seed": "node database/seed_data.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "validate": "npm run lint && npm run test",
    "build": "echo 'Build completed - ready for deployment'",
    "health-check": "curl -f http://localhost:7812/health || exit 1"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "cookie-parser": "^1.4.6",
    "express-session": "^1.17.3",
    "express-rate-limit": "^6.7.0",
    "bcrypt": "^5.1.0",
    "jsonwebtoken": "^9.0.0",
    "pg": "^8.11.0",
    "axios": "^1.4.0",
    "dotenv": "^16.1.4"
  },
  "devDependencies": {
    "jest": "^29.5.0",
    "supertest": "^6.3.3",
    "nodemon": "^2.0.22",
    "eslint": "^8.43.0"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "keywords": [
    "authentication",
    "single-login",
    "domain-driven-design",
    "clickup-oauth",
    "jwt",
    "nodejs",
    "postgresql"
  ],
  "author": "TaskFlow Pro Team",
  "license": "MIT",
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "domain/**/*.js",
      "application/**/*.js",
      "infrastructure/**/*.js",
      "api/**/*.js",
      "!**/node_modules/**"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ]
  }
}